        "bx" : [-0.5],
        "by" : [0.866],
        "cx" : [-0.5],
        "cy" : [-0.866],
        "hx" : [0.0, "fixed"],
        "hy" : [-0.1, "fixed"],
        "gx" : [-0.1, "fixed"],
        "gy" : [0.1, "fixed"],
        "kx" : [0.1, "fixed"],
        "ky" : [0.0, "fixed"]
    },
    "func" : {
