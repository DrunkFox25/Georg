        },
        {
            "type" : "POLY",
            "expression" : "(ay-ky)*dist2(bx,by,cx,cy)+(by-ky)*dist2(cx,cy,ax,ay)+(cy-ky)*dist2(ax,ay,bx,by)"
        }
    ],
    "draw" : [
