    },
    "constr" : [
        {
            "type" : "POLY",
            "expression" : "ax+bx+cx-3gx"
        },
        {
            "type" : "POLY",
            "expression" : "ay+by+cy-3gy"
        },
        {
            "type" : "POLY",
            "expression" : "(hx-ax)*(bx-cx)+(hy-ay)*(by-cy)"
        },
        {
            "type" : "POLY",
            "expression" : "(hx-bx)*(ax-cx)+(hy-by)*(ay-cy)"
        },
        {
            "type" : "POLY",
